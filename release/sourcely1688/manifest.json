{
  "manifest_version": 3,
  "name": "Sourcely — 1688 Supplier Check",
  "version": "1.0.0",
  "description": "Open any 1688 product page and instantly check whether the supplier is reliable.",
  "permissions": ["sidePanel", "activeTab", "storage", "tabs", "identity"],
  "host_permissions": [
    "*://*.1688.com/*",
    "https://sourcely1688.com/*"
  ],
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_title": "Sourcely — 1688 Supplier Check",
    "default_icon": {
      "16": "icons/16.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "background": {
    "service_worker": "service-worker.js"
  }
}
