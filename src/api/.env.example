# ===== 应用 =====
APP_NAME=AI Code Kit
DEBUG=false
TEST_MODE=true

# ===== 数据库 =====
DATABASE_HOST=127.0.0.1
DATABASE_PORT=3306
DATABASE_NAME=sourcely_DB
DATABASE_USER=myuser
DATABASE_PASSWORD=your-password-here

# ===== JWT =====
JWT_SECRET_KEY=change-me-to-random-jwt-secret
JWT_EXPIRE_MINUTES=129600

# ===== Apify 1688 数据采集 =====
APIFY_TOKEN1=apify_api_xxx
APIFY_TOKEN2=
APIFY_TOKEN3=
APIFY_ACTOR_ID=zen-studio~1688-wholesale-scraper
APIFY_TIMEOUT=30
APIFY_POLL_INTERVAL=1
# ===== 用户分析配额（按 tier 每日补地板，懒重置）=====
SIGNUP_BONUS_QUOTA=10
DAILY_FREE_QUOTA=3
DAILY_PAID_QUOTA=20
# ===== 历史记录上限（自动落库，超限 FIFO 清理未收藏）=====
HISTORY_FREE_MAX=20
HISTORY_PAID_MAX=100

# ===== Google OAuth 2.0 =====
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8008/google-callback
CHROME_EXTENSION_ID=your-extension-id

# ===== 汇率（1 USD = X 本地货币） =====
CNY_USD_RATE=7.2
FX_VND=25450
FX_THB=35.7
FX_IDR=16100
FX_MYR=4.65
FX_PHP=57.2

# ===== Qwen3 翻译（新加坡节点，OpenAI 兼容接口） =====
QWEN_API_KEY=your-qwen-api-key
QWEN_MODEL=qwen-flash  # 百炼 MaaS 上的实际模型名，不是 Qwen3.7-Flash
QWEN_API_BASE=https://dashscope-intl.aliyuncs.com/compatible-mode/v1

# ===== 日志 =====
# 日志文件目录。不设则默认 src/api/logs/
LOG_DIR=

# ===== Sentry 错误监控 =====
SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx
