# ===== 应用 =====
APP_NAME=Sourcely
DEBUG=false
TEST_MODE=false
PORT=8008

# ===== 数据库 =====
DATABASE_HOST=127.0.0.1
DATABASE_PORT=3306
DATABASE_NAME=sourcely_DB
DATABASE_USER=myuser
DATABASE_PASSWORD=your-password-here
DB_POOL_MIN=5
DB_POOL_MAX=20

# ===== JWT =====
JWT_SECRET_KEY=change-me-to-random-jwt-secret
JWT_EXPIRE_MINUTES=129600

# ===== Apify 1688 数据采集 =====
APIFY_TOKEN1=apify_api_xxx
APIFY_TOKEN2=
APIFY_TOKEN3=
APIFY_ACTOR_ID=zen-studio~1688-wholesale-scraper
APIFY_WAIT_SECONDS=90

# ===== 用户分析配额（按 tier 每日补地板，懒重置）=====
SIGNUP_BONUS_QUOTA=10
DAILY_FREE_QUOTA=3
DAILY_PAID_QUOTA=20
PAID_ONETIME_QUOTA=300  # bot 付费一次性开通配额（不限时间，不每日重置）

# ===== Telegram bot =====
TELEGRAM_BOT_TOKEN=your-telegram-bot-token  # @BotFather 创建，真值只放 .env 不放此模板
BOT_SECRET=your-bot-secret  # bot 进程→后端 鉴权共享密钥，真值只放 .env
BOT_API_BASE=http://127.0.0.1:8008  # bot 进程→后端 API 地址（部署时改成 https://sourcely1688.com）

# ===== 历史记录上限（自动落库，超限 FIFO 清理未收藏）=====
HISTORY_FREE_MAX=20
HISTORY_PAID_MAX=100

# ===== Google OAuth 2.0 =====
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8008/google-callback
CHROME_EXTENSION_ID=your-extension-id
OAUTH_TIMEOUT=15.0

# ===== 汇率（1 USD = X 本地货币） =====
CNY_USD_RATE=7.2
FX_VND=25450
FX_THB=35.7
FX_IDR=16100
FX_MYR=4.65
FX_RUB=95
FX_PHP=57.2

# ===== Qwen3 翻译（新加坡节点，OpenAI 兼容接口） =====
QWEN_API_KEY=your-qwen-api-key
QWEN_MODEL=qwen-flash
QWEN_API_BASE=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
QWEN_TIMEOUT=20.0
QWEN_TEMPERATURE=0.1
QWEN_MAX_TOKENS=4096

# ===== 限流 =====
RATE_LIMIT_MAX=30
RATE_LIMIT_WINDOW=60

# ===== 异步任务容器 =====
TASK_TTL=1800
MAX_TASKS=200
MAX_PENDING=50
MAX_FAIL_COUNT=1000
FAIL_TTL=86400
FAIL_RETRY_MAX=3
ERROR_LOOKBACK_SECONDS=300

# ===== 图片代理 =====
PROXY_TIMEOUT=15.0

# ===== 日志 =====
# 日志文件目录。不设则默认 src/api/logs/
LOG_DIR=

# ===== Sentry 错误监控 =====
SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx

# ===== Admin 管理后台（自用，必须自己改强密码） =====
ADMIN_USERNAME=admin
ADMIN_PASSWORD=amin!@#
ADMIN_TOKEN_EXPIRE_HOURS=12
