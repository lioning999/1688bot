{
  "manifest_version": 3,
  "name": "Sourcely — 1688 供应商背调",
  "version": "1.0.0",
  "description": "打开 1688 产品页，一键查供应商靠不靠谱。",
  "permissions": ["sidePanel", "activeTab", "storage", "tabs", "identity"],
  "host_permissions": [
    "*://*.1688.com/*",
    "http://localhost:8008/*",
    "http://127.0.0.1:8008/*"
  ],
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_title": "Sourcely — 1688 供应商背调",
    "default_icon": {
      "16": "icons/16.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "background": {
    "service_worker": "service-worker.js"
  }
}
